    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
