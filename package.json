  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --port=4173 --host=127.0.0.1",
    "clean": "node -e \"['dist', 'server.js'].forEach(p => require('fs').rmSync(p, { recursive: true, force: true }))\"",
    "lint": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "test": "vitest run --project unit",
